.{
    .name = .charttable,
    // Not a release number, and it never changes. A release takes its version
    // from the tag (-Dversion), so there is nothing here to keep in step. A
    // build from a source checkout reports this instead, which is what it is.
    .version = "0.0.0-dev",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0xf9efa2121e26fedc,
    // The image codecs, for a target that cannot take them from the platform
    // (build/codecs.zig — Windows today). Lazy, so a build that links Homebrew's
    // archives or the system packages fetches nothing.
    .dependencies = .{
        .libwebp = .{
            .url = "https://github.com/webmproject/libwebp/archive/refs/tags/v1.4.0.tar.gz",
            .hash = "N-V-__8AANi8eADiw0ejg469Q_mXU5ubPV56A0b6-qnlXauz",
            .lazy = true,
        },
        .zlib = .{
            .url = "https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz",
            .hash = "N-V-__8AAJj_QgDBhU17TCtcvdjOZZPDfkvxrEAyZkc14VN8",
            .lazy = true,
        },
        .libpng = .{
            .url = "https://github.com/pnggroup/libpng/archive/refs/tags/v1.6.44.tar.gz",
            .hash = "N-V-__8AAF9GXgBOG-9Fli-wPkVxDfX1YVk83NC29k421PfU",
            .lazy = true,
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "build", "src", "shaders", "include", "LICENSE", "THIRD-PARTY-NOTICES.md" },
}
